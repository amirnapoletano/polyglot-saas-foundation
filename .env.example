# Supabase
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Test / Sandbox)
PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Email (Resend) — optional in dev, emails are logged to console when missing
RESEND_API_KEY=
EMAIL_FROM=Polyglot <noreply@yourdomain.com>

# OAuth — Configure providers in Supabase Dashboard > Authentication > Providers
# Google: Create OAuth credentials at console.cloud.google.com, add client ID/secret in Supabase
# GitHub: Create OAuth app at github.com/settings/developers, add client ID/secret in Supabase
# No env vars needed here — provider config lives in the Supabase dashboard
